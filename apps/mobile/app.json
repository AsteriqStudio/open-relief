{
  "expo": {
    "name": "open-relief",
    "slug": "open-relief",
    "scheme": "openrelief",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-image-picker", "expo-document-picker", "expo-secure-store", ["@stripe/stripe-react-native", { "merchantIdentifier": "", "enableGooglePay": false }]],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "org.openrelief.app"
    }
  }
}
