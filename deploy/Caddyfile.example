# Copy with a real sandbox domain only after DNS points at this host.
# The API stays bound to loopback; Caddy is the sole public listener.
{$OPEN_RELIEF_SANDBOX_DOMAIN} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}
