# Copy to deploy/private-sandbox.env. Do not commit that file.
# This environment is only for synthetic-data, nonfinancial testing.
RUNTIME_MODE=private_sandbox
PORT=3000
API_BIND_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://sandbox.example.org

DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/open_relief?sslmode=require
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379
S3_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
S3_BUCKET=open-relief-private-sandbox
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_PRIVATE_OBJECT_STORAGE_KEY
S3_SECRET_KEY=REPLACE_WITH_PRIVATE_OBJECT_STORAGE_SECRET

# Generate distinct 32-byte hexadecimal values. Store them in the host secret manager.
ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
AUTH_JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
MOCK_STRIPE_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Keep these values fixed for the private sandbox. Do not add live payment credentials.
METHOD_PROVIDER=mock
OCR_PROVIDER=mock
