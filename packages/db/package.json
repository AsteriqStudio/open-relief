{
  "name": "@open-relief/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./security/encryption": {
      "types": "./dist/security/encryption.d.ts",
      "default": "./dist/security/encryption.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/security/encryption.test.js",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "backfill-fingerprints": "tsx src/backfillFingerprints.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@open-relief/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6"
  }
}
